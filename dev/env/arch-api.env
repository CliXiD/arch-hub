# arch-api against the local stack (dev/compose.yaml). Dummy values only. [SPEC-operations-05]

# Database [ADR-0004]
DATABASE_URL=postgres://arch:arch@localhost:5432/arch?sslmode=disable
# Migrations run as the table owner [ADR-0014]. Once the write-API slice merges (it adds the
# grants), DATABASE_URL switches to the runtime role:
# DATABASE_URL=postgres://arch_app:arch_app@localhost:5432/arch?sslmode=disable
MIGRATE_DATABASE_URL=postgres://arch:arch@localhost:5432/arch?sslmode=disable

# HTTP [SPEC-operations-02]
HTTP_ADDR=:8080
METRICS_ADDR=:9090
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Identity: Keycloak realm `arch` [ADR-0008] [SPEC-identity-access-02]
OIDC_ISSUER=http://localhost:8180/realms/arch
OIDC_AUDIENCE=arch-api
# OIDC_JWKS_URL is discovered from the issuer; the arch-api container overrides it.

# Tracing [ADR-0011]: off while unset. With `dev/bin/stack up tracing`, uncomment:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# arch CLI against the local API, as the dev CI client [SPEC-yaml-as-code-08]
ARCH_URL=http://localhost:8080
ARCH_ISSUER=http://localhost:8180/realms/arch
ARCH_CLIENT_ID=arch-ci-platform
ARCH_CLIENT_SECRET=dev-ci-secret
