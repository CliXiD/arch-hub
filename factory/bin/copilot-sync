#!/usr/bin/env python3
"""Mirror the hub's Claude Code skills and agents for GitHub Copilot.

  factory/bin/copilot-sync           write the mirrors
  factory/bin/copilot-sync --check   exit 1 if any mirror is missing or stale (writes nothing)

Sources (edit these)                    Mirrors (generated, don't edit)
  .claude/skills/<name>/...         →   .github/skills/<name>/...        Copilot skills (/name)
  .claude/agents/<name>.md          →   .github/agents/<name>.agent.md   Copilot custom agents

Instructions need no mirror: AGENTS.md is the hub's instructions for every agent, and
CLAUDE.md imports it (@AGENTS.md).

Skills are copied as they are (Copilot reads the same SKILL.md frontmatter: name,
description, disable-model-invocation, argument-hint). Skills listed in SKIP_SKILLS need
Claude Code features Copilot lacks and aren't mirrored.

Agents are converted: name and description are kept; Claude tool names become Copilot
aliases (Read→read, Grep/Glob→search, Bash→execute, Edit/Write→edit, WebFetch/WebSearch→web);
an agent without a tools line gets every tool; `model` is dropped (Copilot uses the model
picked in the session; the Claude model is noted in the body) and so are `hooks` (Claude Code
hook commands). Mirrors whose source is gone are removed, but only files this script wrote.
"""

import json
import re
import shutil
import sys
from pathlib import Path

HUB = Path(__file__).resolve().parents[2]
SRC_SKILLS, SRC_AGENTS = HUB / ".claude/skills", HUB / ".claude/agents"
DST_SKILLS, DST_AGENTS = HUB / ".github/skills", HUB / ".github/agents"
SKIP_SKILLS = {"factory"}   # the orchestrator: background agents, SendMessage, transcripts
MARK = "Generated by factory/bin/copilot-sync"
TOOLS = {"Read": "read", "Grep": "search", "Glob": "search", "Bash": "execute", "Edit": "edit",
         "Write": "edit", "NotebookEdit": "edit", "WebFetch": "web", "WebSearch": "web",
         "Agent": "agent", "Task": "agent", "TodoWrite": "todo"}


def split(text):
    """(frontmatter lines, body) of a markdown file with --- frontmatter."""
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if not m:
        return None, text
    return m.group(1).splitlines(), m.group(2)


def fields(lines):
    """Top-level `key: value` pairs; nested blocks (hooks:) are skipped."""
    out = {}
    for line in lines:
        if not line.strip():
            continue
        if line[0] in " \t-":
            continue
        key, _, value = line.partition(":")
        out[key.strip()] = value.strip()
    return out


def unquote(v):
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    return v


def skill_files():
    """{mirror path: content bytes} for every mirrored skill file."""
    out = {}
    for d in sorted(p for p in SRC_SKILLS.iterdir() if p.is_dir()) if SRC_SKILLS.exists() else []:
        if d.name in SKIP_SKILLS or not (d / "SKILL.md").exists():
            continue
        for f in sorted(p for p in d.rglob("*") if p.is_file()):
            rel = f.relative_to(SRC_SKILLS)
            data = f.read_bytes()
            if f.name == "SKILL.md":
                fm, body = split(data.decode())
                name = unquote(fields(fm or []).get("name", ""))
                if name != d.name:
                    sys.exit(f"copilot-sync: .claude/skills/{d.name}/SKILL.md has name {name!r}; Copilot needs it to match the folder")
                note = f"<!-- {MARK} from .claude/skills/{rel}. Edit the source, then run factory/bin/copilot-sync. -->\n"
                data = ("---\n" + "\n".join(fm) + "\n---\n" + note + body).encode()
            out[DST_SKILLS / rel] = data
    return out


def agent_files():
    out = {}
    for f in sorted(SRC_AGENTS.glob("*.md")) if SRC_AGENTS.exists() else []:
        fm, body = split(f.read_text())
        if fm is None:
            continue
        meta = fields(fm)
        name = unquote(meta.get("name", f.stem))
        lines = ["---", f"name: {name}", f"description: {json.dumps(unquote(meta.get('description', '')), ensure_ascii=False)}"]
        if meta.get("tools"):
            mapped = []
            for t in [t.strip() for t in unquote(meta["tools"]).strip("[]").split(",") if t.strip()]:
                alias = TOOLS.get(t, t if "/" in t else None)
                if alias and alias not in mapped:
                    mapped.append(alias)
            lines.append("tools: [" + ", ".join(f"'{t}'" for t in mapped) + "]")
        lines.append("---")
        notes = [f"{MARK} from .claude/agents/{f.name}. Edit the source, then run factory/bin/copilot-sync."]
        if meta.get("model"):
            notes.append(f"In Claude Code this agent runs on {meta['model']}; pick a comparable model here.")
        if any(l.startswith("hooks:") for l in fm):
            notes.append("Claude Code also runs a hook for this agent (see the source); in Copilot, do that step yourself "
                         "(for the builder: run the repo checks before you finish).")
        out[DST_AGENTS / f"{f.stem}.agent.md"] = ("\n".join(lines) + "\n<!-- " + " ".join(notes) + " -->\n" + body).encode()
    return out


def generated(path):
    try:
        return MARK in path.read_text(errors="replace")
    except OSError:
        return False


def main(argv):
    check = "--check" in argv
    want = {**skill_files(), **agent_files()}
    stale = [p for p, data in want.items() if not p.exists() or p.read_bytes() != data]
    orphans = [p for root in (DST_SKILLS, DST_AGENTS) if root.exists() for p in root.rglob("*.md")
               if p not in want and generated(p)]
    if check:
        for p in stale:
            print(f"stale    {p.relative_to(HUB)}")
        for p in orphans:
            print(f"orphan   {p.relative_to(HUB)}")
        print(f"copilot-sync: {len(want)} mirrored files, {len(stale)} stale, {len(orphans)} orphaned")
        sys.exit(1 if stale or orphans else 0)
    for p in stale:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_bytes(want[p])
        print(f"wrote    {p.relative_to(HUB)}")
    for p in orphans:
        p.unlink()
        print(f"removed  {p.relative_to(HUB)}")
        if p.parent != DST_SKILLS and p.parent.exists() and not any(p.parent.iterdir()):
            p.parent.rmdir()
    print(f"copilot-sync: {len(want)} mirrored files ({len(stale)} updated, {len(orphans)} removed); "
          f"skipped skills: {', '.join(sorted(SKIP_SKILLS))}")


if __name__ == "__main__":
    main(sys.argv[1:])
