#!/usr/bin/env python3
"""Serve the factory dashboard and the job history on localhost.

    factory/bin/serve [--port 8000] [--bind 127.0.0.1]

Only factory/ and docs/ are served, so repos/ (and every .env in them), .worktrees/
and the rest of the hub stay private. / opens the dashboard; history.html reads
docs/history/, which `python3 -m http.server` inside factory/ cannot reach.
"""
import argparse
import functools
import http.server
import os
import sys
from pathlib import Path
from urllib.parse import unquote, urlsplit

HUB = Path(__file__).resolve().parents[2]
ALLOWED = ("factory", "docs")
HIDDEN = (".env",)  # never served, even if one ends up under docs/ or factory/


class Handler(http.server.SimpleHTTPRequestHandler):
    def _allowed(self):
        path = unquote(urlsplit(self.path).path)
        parts = [p for p in path.split("/") if p]
        if not parts or parts[0] not in ALLOWED or ".." in parts:
            return False
        if any(p.startswith(HIDDEN) for p in parts):
            return False
        # Symlinks must not lead out of the allowed folders.
        real = (HUB / Path(*parts)).resolve()
        return any(real == (HUB / a).resolve() or (HUB / a).resolve() in real.parents for a in ALLOWED)

    def _route(self):
        path = urlsplit(self.path).path
        if path in ("", "/"):
            self.send_response(302)
            self.send_header("Location", "/factory/dashboard.html")
            self.end_headers()
            return False
        if path in ("/history", "/history/"):
            self.send_response(302)
            self.send_header("Location", "/factory/history.html")
            self.end_headers()
            return False
        if not self._allowed():
            self.send_error(404, "Not served: only /factory/ and /docs/ are")
            return False
        return True

    def do_GET(self):
        if self._route():
            super().do_GET()

    def do_HEAD(self):
        if self._route():
            super().do_HEAD()

    def end_headers(self):
        # Polling must see fresh job files.
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def log_message(self, fmt, *args):
        if os.environ.get("FACTORY_SERVE_LOG"):
            super().log_message(fmt, *args)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--port", type=int, default=int(os.environ.get("FACTORY_PORT", 8000)))
    ap.add_argument("--bind", default="127.0.0.1", help="default 127.0.0.1 (this machine only)")
    a = ap.parse_args()
    handler = functools.partial(Handler, directory=str(HUB))
    try:
        srv = http.server.ThreadingHTTPServer((a.bind, a.port), handler)
    except OSError as e:
        sys.exit(f"serve: cannot listen on {a.bind}:{a.port}: {e} (try --port {a.port + 1})")
    print(f"dashboard  http://localhost:{a.port}/\nhistory    http://localhost:{a.port}/history\n"
          f"serving only factory/ and docs/ from {HUB}; Ctrl-C to stop", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
